---
import Base from "../layouts/Base.astro";
---
<Base title="Contact | Connie Trinh" description="Contact Connie Trinh.">
  <section class="page-intro">
    <h1>Contact</h1>
    <p>
      Send a note and I will get back to you. Submitting opens your email app with your message ready, so you can review it before you send it.
    </p>
  </section>

  <!-- The address is stored in the form's action, so it is not shown on the page. -->
  <form
    class="contact-form"
    action="mailto:cht4ha@virginia.edu?subject=Website%20message"
    method="post"
    enctype="text/plain"
  >
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="email">Your email</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="6" required></textarea>
    </div>
    <button class="button" type="submit">Send message</button>
  </form>

  <p class="note" style="margin-top:1.5rem">
    Nothing you type here is stored on this website. Your message goes directly from your email app.
  </p>
</Base>
